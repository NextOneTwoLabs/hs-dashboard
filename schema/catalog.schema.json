{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hs-dashboard.local/schema/catalog.schema.json",
  "title": "Every state's catalog in one file (public/archive/catalog.json, schema 2)",
  "description": "/api/v1/catalog: seasons (newest first) -> competitions of every state -> divisions. hsdash.py validate also checks that it carries exactly the state catalogs' competitions and notes. `_meta.asOf` is null: it is built from several brackets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "_meta", "activeSeason", "latestSeason", "genders", "states", "competitions", "seasons"],
  "properties": {
    "schema": {"const": 2},
    "_meta": {"$ref": "common.schema.json#/$defs/buildMeta"},
    "activeSeason": {"$ref": "common.schema.json#/$defs/season"},
    "latestSeason": {"anyOf": [{"$ref": "common.schema.json#/$defs/season"}, {"type": "null"}]},
    "genders": {"$ref": "common.schema.json#/$defs/genderCodes"},
    "states": {
      "type": "object",
      "propertyNames": {"$ref": "common.schema.json#/$defs/state"},
      "additionalProperties": {"$ref": "common.schema.json#/$defs/stateMeta"}
    },
    "competitions": {
      "type": "object",
      "propertyNames": {"$ref": "common.schema.json#/$defs/competitionId"},
      "additionalProperties": {"$ref": "common.schema.json#/$defs/competitionMeta"}
    },
    "seasons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["season", "notes", "competitions"],
        "properties": {
          "season": {"$ref": "common.schema.json#/$defs/season"},
          "notes": {
            "type": "object",
            "propertyNames": {"$ref": "common.schema.json#/$defs/state"},
            "additionalProperties": {"type": "string", "minLength": 1}
          },
          "competitions": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/catalogCompetition"}}
        }
      }
    }
  }
}
